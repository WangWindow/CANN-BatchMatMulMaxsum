// Local multi-case test runner — runs all cases in cases.txt with timing.
// Usage: ./batch_matmul_max_sum_custom [cases.txt]

#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <sstream>
#include <string>
#include <vector>

#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)

#include "kernel.asc"

struct CaseDesc {
    std::string name;
    int64_t b, m, n, k;
    int32_t dtype;  // 1=fp16, 2=bf16
    bool tx1, tx2;
    bool golden;
};

static bool LoadCases(const std::string& path, std::vector<CaseDesc>& cases)
{
    std::ifstream file(path);
    if (!file.is_open()) {
        return false;
    }
    std::string line;
    while (std::getline(file, line)) {
        if (line.empty() || line[0] == '#') {
            continue;
        }
        std::istringstream iss(line);
        CaseDesc c;
        int tx1, tx2, golden;
        if (!(iss >> c.name >> c.b >> c.m >> c.n >> c.k >> c.dtype >> tx1 >> tx2 >> golden)) {
            continue;
        }
        c.tx1 = tx1 != 0;
        c.tx2 = tx2 != 0;
        c.golden = golden != 0;
        cases.push_back(c);
    }
    return !cases.empty();
}

static bool ReadBin(const std::string& path, size_t bytes, void* hostBuf)
{
    std::ifstream file(path, std::ios::binary);
    if (!file.is_open()) {
        fprintf(stderr, "[ERROR] cannot open %s\n", path.c_str());
        return false;
    }
    file.seekg(0, std::ios::end);
    if (static_cast<size_t>(file.tellg()) != bytes) {
        fprintf(stderr, "[ERROR] %s size mismatch (want %zu bytes)\n", path.c_str(), bytes);
        return false;
    }
    file.seekg(0, std::ios::beg);
    file.read(static_cast<char*>(hostBuf), bytes);
    return file.good();
}

static bool CheckFinite(const float* y, int64_t b)
{
    for (int64_t i = 0; i < b; ++i) {
        if (!std::isfinite(y[i])) {
            return false;
        }
    }
    return true;
}

// ---------------------------------------------------------------------------
// Debug path: launch the kernel with our own buffers and dump the C tiles
// the matmul server writes into cWorkspace, for offline comparison.
// The cases.txt line `dbg` triggers this instead of the normal flow.
// ---------------------------------------------------------------------------
#define ACL_CHECK_DBG(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return; } } while(0)
static void RunDebugDump(aclrtStream stream, int64_t coreNum, const CaseDesc& c)
{
    using namespace batch_matmul_max_sum_host;

    const uint32_t batch = static_cast<uint32_t>(c.b);
    const uint32_t m = static_cast<uint32_t>(c.m);
    const uint32_t n = static_cast<uint32_t>(c.n);
    const uint32_t k = static_cast<uint32_t>(c.k);
    const uint32_t taskM = std::min(m, batch_matmul_max_sum_detail::kMTask);
    const uint32_t mTiles = CeilDiv(m, taskM);
    const uint32_t taskN = std::min(n, batch_matmul_max_sum_detail::kBaseN);
    const uint32_t nShards = CeilDiv(n, taskN);
    const uint32_t baseM = RoundUp(taskM, 16);
    const uint32_t baseN = RoundUp(taskN, 16);
    const uint32_t blockCount = 1;
    const uint32_t partialStride = baseM;

    HostTiling hostTiling;
    if (!BuildMatmulTiling(m, n, k, taskM, taskN, baseM, baseN, blockCount, c.dtype, c.tx1, c.tx2, hostTiling)) {
        fprintf(stderr, "[dbg] BuildMatmulTiling failed\n");
        return;
    }
    {
        const int32_t* fields = reinterpret_cast<const int32_t*>(hostTiling.data.data());
        printf("[dbg] tiling fields: usedCoreNum=%d M=%d N=%d Ka=%d Kb=%d singleCoreM=%d singleCoreN=%d singleCoreK=%d "
               "baseM=%d baseN=%d baseK=%d depthA1=%d depthB1=%d stepM=%d stepN=%d isBias=%d transLength=%d "
               "iterateOrder=%d\n",
               fields[0], fields[1], fields[2], fields[3], fields[4], fields[5], fields[6], fields[7], fields[8],
               fields[9], fields[10], fields[11], fields[12], fields[13], fields[14], fields[15], fields[16],
               fields[17]);
    }

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    size_t workspaceBytes = ascendcPlatform->GetLibApiWorkSpaceSize();
    if (workspaceBytes == 0) {
        workspaceBytes = 32;
    }
    const size_t cWorkspaceBytes = static_cast<size_t>(blockCount) * m * n * sizeof(float);

    uint8_t* tilingDevice = nullptr;
    uint8_t* workspaceDevice = nullptr;
    uint8_t* cWorkspaceDevice = nullptr;
    ACL_CHECK_DBG(aclrtMalloc((void**)&tilingDevice, hostTiling.data.size(), ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK_DBG(aclrtMalloc((void**)&workspaceDevice, workspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK_DBG(aclrtMalloc((void**)&cWorkspaceDevice, cWorkspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK_DBG(aclrtMemcpy(tilingDevice, hostTiling.data.size(), hostTiling.data.data(), hostTiling.data.size(),
                          ACL_MEMCPY_HOST_TO_DEVICE));

    // inputs: A = m*k, B = k*n elements of dtype
    const size_t x1Bytes = static_cast<size_t>(batch) * m * k * 2;
    const size_t x2Bytes = static_cast<size_t>(batch) * n * k * 2;
    uint8_t* x1Host = nullptr, * x1Dev = nullptr, * x2Host = nullptr, * x2Dev = nullptr;
    uint8_t* yHost = nullptr, * yDev = nullptr;
    uint8_t* dumpHost = nullptr, * dumpDev = nullptr;
    const size_t dumpBytes = (static_cast<size_t>(nShards) * 2 * partialStride + static_cast<size_t>(mTiles) * partialStride +
                              static_cast<size_t>(mTiles) * 8 + 40) * sizeof(float);
    ACL_CHECK_DBG(aclrtMallocHost((void**)&x1Host, x1Bytes));
    ACL_CHECK_DBG(aclrtMallocHost((void**)&x2Host, x2Bytes));
    ACL_CHECK_DBG(aclrtMallocHost((void**)&yHost, 4 * batch));
    ACL_CHECK_DBG(aclrtMallocHost((void**)&dumpHost, dumpBytes));
    ACL_CHECK_DBG(aclrtMalloc((void**)&x1Dev, x1Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK_DBG(aclrtMalloc((void**)&x2Dev, x2Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK_DBG(aclrtMalloc((void**)&yDev, 4 * batch, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK_DBG(aclrtMalloc((void**)&dumpDev, dumpBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ReadBin("input/dbg/x1.bin", x1Bytes, x1Host);
    ReadBin("input/dbg/x2.bin", x2Bytes, x2Host);
    ACL_CHECK_DBG(aclrtMemcpy(x1Dev, x1Bytes, x1Host, x1Bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK_DBG(aclrtMemcpy(x2Dev, x2Bytes, x2Host, x2Bytes, ACL_MEMCPY_HOST_TO_DEVICE));

    if (c.dtype == 1) {
        batch_matmul_max_sum_detail::batch_matmul_max_sum_fp16_debug<<<blockCount, nullptr, stream>>>(
            (GM_ADDR)x1Dev, (GM_ADDR)x2Dev, (GM_ADDR)yDev, workspaceDevice, cWorkspaceDevice, tilingDevice, batch,
            m, n, k, mTiles, nShards, taskM, taskN, partialStride, blockCount, c.tx1 ? 1 : 0, c.tx2 ? 1 : 0,
            dumpDev);
    } else {
        batch_matmul_max_sum_detail::batch_matmul_max_sum_bf16<<<blockCount, nullptr, stream>>>(
            (GM_ADDR)x1Dev, (GM_ADDR)x2Dev, (GM_ADDR)yDev, workspaceDevice, cWorkspaceDevice, tilingDevice, batch,
            m, n, k, mTiles, nShards, taskM, taskN, partialStride, blockCount, c.tx1 ? 1 : 0, c.tx2 ? 1 : 0);
    }
    ACL_CHECK_DBG(aclrtSynchronizeStream(stream));
    ACL_CHECK_DBG(aclrtMemcpy(yHost, 4 * batch, yDev, 4 * batch, ACL_MEMCPY_DEVICE_TO_HOST));

    uint8_t* cHost = nullptr;
    ACL_CHECK_DBG(aclrtMallocHost((void**)&cHost, cWorkspaceBytes));
    ACL_CHECK_DBG(aclrtMemcpy(cHost, cWorkspaceBytes, cWorkspaceDevice, cWorkspaceBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    ACL_CHECK_DBG(aclrtMemcpy(dumpHost, dumpBytes, dumpDev, dumpBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    {
        std::ofstream f("output/dbg/tiles.bin", std::ios::binary | std::ios::trunc);
        f.write(reinterpret_cast<const char*>(cHost), cWorkspaceBytes);
        std::ofstream fy("output/dbg/y.bin", std::ios::binary | std::ios::trunc);
        fy.write(reinterpret_cast<const char*>(yHost), 4 * batch);
        std::ofstream fd("output/dbg/dump.bin", std::ios::binary | std::ios::trunc);
        fd.write(reinterpret_cast<const char*>(dumpHost), dumpBytes);
    }
    printf("[dbg] dumped %zu tile bytes + %zu dump bytes (m=%u n=%u k=%u mTiles=%u nShards=%u)\n",
           cWorkspaceBytes, dumpBytes, m, n, k, mTiles, nShards);

    aclrtFreeHost(cHost);
    aclrtFree(dumpDev);
    aclrtFreeHost(dumpHost);
    aclrtFree(yDev);
    aclrtFreeHost(yHost);
    aclrtFree(x2Dev);
    aclrtFreeHost(x2Host);
    aclrtFree(x1Dev);
    aclrtFreeHost(x1Host);
    aclrtFree(cWorkspaceDevice);
    aclrtFree(workspaceDevice);
    aclrtFree(tilingDevice);
}

int main(int argc, char** argv)
{
    std::string casesPath = argc > 1 ? argv[1] : "cases.txt";
    std::vector<CaseDesc> cases;
    if (!LoadCases(casesPath, cases)) {
        fprintf(stderr, "[ERROR] no cases loaded from %s\n", casesPath.c_str());
        return 1;
    }

    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        fprintf(stderr, "[ERROR] invalid core num\n");
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));
    printf("availableCoreNum=%lld\n", (long long)availableCoreNum);

    std::ofstream timingFile("timing.tsv");
    timingFile << "case\tB\tM\tN\tK\tdtype\ttx1\ttx2\tmed_ms\titers\n";

    bool allOk = true;
    for (const auto& c : cases) {
        if (c.name == "dbg") {
            RunDebugDump(stream, availableCoreNum, c);
            continue;
        }
        const size_t x1Bytes = static_cast<size_t>(c.b) * c.m * c.k * 2;
        const size_t x2Bytes = static_cast<size_t>(c.b) * c.n * c.k * 2;
        const size_t yBytes = static_cast<size_t>(c.b) * sizeof(float);

        // storage shape: (B, K, M) if tx1 else (B, M, K)
        int64_t x1Shape[3] = {c.b, c.tx1 ? c.k : c.m, c.tx1 ? c.m : c.k};
        // storage shape: (B, N, K) if tx2 else (B, K, N)
        int64_t x2Shape[3] = {c.b, c.tx2 ? c.n : c.k, c.tx2 ? c.k : c.n};
        int64_t yShape[1] = {c.b};

        TensorInfo x1Tensors[] = {{x1Shape, 3, c.dtype}};
        TensorGroupInfo info_x1 = {x1Tensors, 1};
        TensorInfo x2Tensors[] = {{x2Shape, 3, c.dtype}};
        TensorGroupInfo info_x2 = {x2Tensors, 1};
        TensorInfo yTensors[] = {{yShape, 1, 0}};
        TensorGroupInfo info_y = {yTensors, 1};

        uint8_t* x1Host = nullptr;
        uint8_t* x1Dev = nullptr;
        uint8_t* x2Host = nullptr;
        uint8_t* x2Dev = nullptr;
        uint8_t* yHost = nullptr;
        uint8_t* yDev = nullptr;

        ACL_CHECK(aclrtMallocHost((void**)&x1Host, x1Bytes));
        ACL_CHECK(aclrtMallocHost((void**)&x2Host, x2Bytes));
        ACL_CHECK(aclrtMallocHost((void**)&yHost, yBytes));
        ACL_CHECK(aclrtMalloc((void**)&x1Dev, x1Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc((void**)&x2Dev, x2Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc((void**)&yDev, yBytes, ACL_MEM_MALLOC_HUGE_FIRST));

        const std::string x1Path = "input/" + c.name + "/x1.bin";
        const std::string x2Path = "input/" + c.name + "/x2.bin";
        bool caseOk = ReadBin(x1Path, x1Bytes, x1Host) && ReadBin(x2Path, x2Bytes, x2Host);
        if (caseOk) {
            ACL_CHECK(aclrtMemcpy(x1Dev, x1Bytes, x1Host, x1Bytes, ACL_MEMCPY_HOST_TO_DEVICE));
            ACL_CHECK(aclrtMemcpy(x2Dev, x2Bytes, x2Host, x2Bytes, ACL_MEMCPY_HOST_TO_DEVICE));

            // warmup
            run_kernel((GM_ADDR)x1Dev, info_x1, (GM_ADDR)x2Dev, info_x2, (GM_ADDR)yDev, info_y,
                       availableCoreNum, stream, c.tx1, c.tx2);
            run_kernel((GM_ADDR)x1Dev, info_x1, (GM_ADDR)x2Dev, info_x2, (GM_ADDR)yDev, info_y,
                       availableCoreNum, stream, c.tx1, c.tx2);

            // timed iterations
            const int minIters = 3;
            const int maxIters = 20;
            std::vector<double> times;
            double totalMs = 0.0;
            for (int iter = 0; iter < maxIters; ++iter) {
                auto t0 = std::chrono::steady_clock::now();
                run_kernel((GM_ADDR)x1Dev, info_x1, (GM_ADDR)x2Dev, info_x2, (GM_ADDR)yDev, info_y,
                           availableCoreNum, stream, c.tx1, c.tx2);
                auto t1 = std::chrono::steady_clock::now();
                double ms = std::chrono::duration<double, std::milli>(t1 - t0).count();
                times.push_back(ms);
                totalMs += ms;
                if (iter + 1 >= minIters && totalMs >= 300.0) {
                    break;
                }
                if (ms > 2000.0 && iter >= 2) {
                    break;  // huge case: don't burn too much wall time
                }
            }
            std::sort(times.begin(), times.end());
            double medMs = times[times.size() / 2];

            ACL_CHECK(aclrtMemcpy(yHost, yBytes, yDev, yBytes, ACL_MEMCPY_DEVICE_TO_HOST));
            const float* yF = reinterpret_cast<const float*>(yHost);
            if (!CheckFinite(yF, c.b)) {
                fprintf(stderr, "[ERROR] case %s: non-finite output\n", c.name.c_str());
                allOk = false;
            }

            {
                std::ofstream outFile("output/" + c.name + "/y.bin", std::ios::binary | std::ios::trunc);
                if (!outFile.is_open()) {
                    fprintf(stderr, "[ERROR] cannot write output for %s\n", c.name.c_str());
                    allOk = false;
                } else {
                    outFile.write(reinterpret_cast<const char*>(yHost), yBytes);
                }
            }

            printf("[%s] B=%lld M=%lld N=%lld K=%lld dtype=%d tx=(%d,%d) -> %.3f ms (median of %zu)\n",
                   c.name.c_str(), (long long)c.b, (long long)c.m, (long long)c.n, (long long)c.k,
                   c.dtype, c.tx1 ? 1 : 0, c.tx2 ? 1 : 0, medMs, times.size());
            timingFile << c.name << "\t" << c.b << "\t" << c.m << "\t" << c.n << "\t" << c.k << "\t"
                       << c.dtype << "\t" << (c.tx1 ? 1 : 0) << "\t" << (c.tx2 ? 1 : 0) << "\t"
                       << medMs << "\t" << times.size() << "\n";
        }
        allOk = allOk && caseOk;

        if (yDev) aclrtFree(yDev);
        if (yHost) aclrtFreeHost(yHost);
        if (x2Dev) aclrtFree(x2Dev);
        if (x2Host) aclrtFreeHost(x2Host);
        if (x1Dev) aclrtFree(x1Dev);
        if (x1Host) aclrtFreeHost(x1Host);
    }

    timingFile.close();
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    printf(allOk ? "=== RUN OK ===\n" : "=== RUN FAILED ===\n");
    return allOk ? 0 : 1;
}
