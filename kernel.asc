#include <algorithm>
#include <cfloat>
#include <cstdint>
#include <mutex>
#include <vector>

#include "kernel_operator.h"

/*
 * BatchMatmulMaxSum — 直调 split-core 手写版本（RAW，不经 KFC matmul 库）。
 *
 * AIC（cube 侧）：公开 Gemm API（src 位于 L1，内部完成 ND->NZ 与 K 循环流水），
 *                 逐 (batch, mTile, nShard) 计算 64x128 C 块，经 Fixpipe 写入
 *                 GM ping-pong 工作区，用核内 flag 与 AIV 同步。
 * AIV（vector 侧）：等 flag -> 读 C 块 -> 按行 ReduceMax 累计 rowMaxAll ->
 *                 全部块完成后 ReduceSum 写 y。
 *
 * 本文件由 main.asc 使用 #include 引入，不定义 main()、pragma once 或头文件保护宏。
 * run_kernel 为判题契约入口，签名与官方模板一致。
 */

using namespace AscendC;

namespace batch_matmul_max_sum_detail {

constexpr float kNegInf = -3.402823466e+38F;
constexpr uint32_t kMTask = 64;    // M 分块行数
constexpr uint32_t kNTask = 128;   // N 分块列数
constexpr uint32_t kKChunk = 256;  // L1 驻留 K 块：A 64x256 + B 256x128 = 96KB，乒乓 x2 = 192KB < L1 512KB
constexpr uint32_t kReduceTmpBytes = 32 * 1024;

/* 核内 AIC<->AIV flag（与 KFC 一致：VEC_WAIT_FIXP=1 为 C->V，CUBE_WAIT_FIXP=2 为 V->C）。 */
constexpr uint8_t kCFlag = 1;
constexpr uint8_t kVFlag = 2;
constexpr uint8_t kIntraMode = 4;  // KFC 的 INTRA_MODE

__aicore__ inline uint32_t CeilDiv(uint32_t value, uint32_t divisor) {
    return (value + divisor - 1) / divisor;
}

__aicore__ inline uint32_t MinU32(uint32_t lhs, uint32_t rhs) {
    return lhs < rhs ? lhs : rhs;
}

/*
 * AIC 侧：一个核负责的 batch 循环，逐 (mTile, nShard) 计算 C 块到 GM ping-pong 区。
 */
template <typename InputT>
__aicore__ inline void RunCube(GM_ADDR x1, GM_ADDR x2, GM_ADDR cWorkspace, uint32_t batch, uint32_t m, uint32_t n,
                               uint32_t k, uint32_t mTiles, uint32_t nShards, uint32_t blockCount, bool transposeX1,
                               bool transposeX2) {
    const uint32_t blockIdx = GetBlockIdx();

    GlobalTensor<InputT> x1Global;
    GlobalTensor<InputT> x2Global;
    x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ InputT *>(x1), static_cast<int64_t>(batch) * m * k);
    x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ InputT *>(x2), static_cast<int64_t>(batch) * k * n);

    GlobalTensor<float> cGlobal;
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(cWorkspace),
                            static_cast<int64_t>(blockCount) * 2 * kMTask * kNTask);

    TPipe pipe;
    TBuf<TPosition::A1> l1BufA;
    TBuf<TPosition::B1> l1BufB;
    TBuf<TPosition::CO1> l0cBuf;
    pipe.InitBuffer(l1BufA, 2 * kKChunk * kMTask * sizeof(InputT));
    pipe.InitBuffer(l1BufB, 2 * kKChunk * kNTask * sizeof(InputT));
    pipe.InitBuffer(l0cBuf, kMTask * kNTask * sizeof(float));

    LocalTensor<InputT> l1A = l1BufA.Get<InputT>(2 * kKChunk * kMTask);
    LocalTensor<InputT> l1B = l1BufB.Get<InputT>(2 * kKChunk * kNTask);
    LocalTensor<float> l0c = l0cBuf.Get<float>(kMTask * kNTask);

    const uint32_t kChunks = CeilDiv(k, kKChunk);
    const uint32_t aHalf = kKChunk * kMTask;  // L1 A 半区元素数
    const uint32_t bHalf = kKChunk * kNTask;  // L1 B 半区元素数

    uint32_t ping = 0;
    for (uint32_t b = blockIdx; b < batch; b += blockCount) {
        for (uint32_t mTileId = 0; mTileId < mTiles; ++mTileId) {
            const uint32_t m0 = mTileId * kMTask;
            for (uint32_t nShardId = 0; nShardId < nShards; ++nShardId) {
                const uint32_t n0 = nShardId * kNTask;

                for (uint32_t kc = 0; kc < kChunks; ++kc) {
                    const uint32_t half = kc & 0x1;
                    const uint32_t k0 = kc * kKChunk;
                    const uint32_t actualK = MinU32(kKChunk, k - k0);
                    LocalTensor<InputT> aHalfBuf = l1A[half * aHalf];
                    LocalTensor<InputT> bHalfBuf = l1B[half * bHalf];

                    /* GM -> L1（ND）。 */
                    if (transposeX1) {
                        for (uint32_t r = 0; r < kMTask; ++r) {
                            DataCopy(aHalfBuf[r * kKChunk],
                                     x1Global[static_cast<int64_t>(b) * m * k + static_cast<int64_t>(k0) * m + m0 + r],
                                     actualK);
                        }
                    } else {
                        for (uint32_t r = 0; r < kMTask; ++r) {
                            DataCopy(aHalfBuf[r * kKChunk],
                                     x1Global[static_cast<int64_t>(b) * m * k +
                                              static_cast<int64_t>(m0 + r) * k + k0],
                                     actualK);
                        }
                    }
                    if (transposeX2) {
                        for (uint32_t c = 0; c < kNTask; ++c) {
                            DataCopy(bHalfBuf[c * kKChunk],
                                     x2Global[static_cast<int64_t>(b) * k * n +
                                              static_cast<int64_t>(n0 + c) * k + k0],
                                     actualK);
                        }
                    } else {
                        for (uint32_t c = 0; c < kNTask; ++c) {
                            DataCopy(bHalfBuf[c * kKChunk],
                                     x2Global[static_cast<int64_t>(b) * k * n + static_cast<int64_t>(k0) * n + n0 + c],
                                     actualK);
                        }
                    }
                    SetFlag<HardEvent::MTE2_MTE1>(half);
                    WaitFlag<HardEvent::MTE2_MTE1>(half);

                    /* Gemm：L0C 内跨 K 累计（首块清零初始化）。 */
                    GemmTiling tiling = GetGemmTiling<InputT>(kMTask, actualK, kNTask);
                    Gemm<float, InputT, InputT>(l0c, aHalfBuf, bHalfBuf, kMTask, actualK, kNTask, tiling, kc != 0, 0);
                    SetFlag<HardEvent::MTE1_MTE2>(half);
                    WaitFlag<HardEvent::MTE1_MTE2>(half);
                }

                /* L0C -> GM（ND 行主序），通知 AIV。 */
                GlobalTensor<float> gmTile =
                    cGlobal[static_cast<int64_t>(blockIdx) * 2 * kMTask * kNTask + ping * kMTask * kNTask];
                FixpipeParamsV220 fixParams(kNTask /*nSize*/, kMTask /*mSize*/, kMTask /*srcStride*/,
                                            kNTask /*dstStride*/, false /*relu*/);
                fixParams.unitFlag = 3;  // 末段搬出
                Fixpipe<float, float, CFG_ROW_MAJOR>(gmTile, l0c, fixParams);
                CrossCoreSetFlag<kIntraMode, PIPE_FIX>(kCFlag);
                CrossCoreWaitFlag<kIntraMode, PIPE_FIX>(kVFlag);
                ping = 1 - ping;
            }
        }
    }
}

/*
 * AIV 侧：读 C 块 -> ReduceMax -> 累计 -> 求和写 y。
 */
template <typename InputT>
__aicore__ inline void RunVector(GM_ADDR y, GM_ADDR cWorkspace, uint32_t batch, uint32_t m, uint32_t n,
                                 uint32_t mTiles, uint32_t nShards, uint32_t partialStride, uint32_t blockCount) {
    const uint32_t blockIdx = GetBlockIdx();

    GlobalTensor<float> yGlobal;
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);
    GlobalTensor<float> cGlobal;
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(cWorkspace),
                            static_cast<int64_t>(blockCount) * 2 * kMTask * kNTask);

    TPipe pipe;
    TQue<TPosition::VECIN, 2> cQueue;
    {
        TQue<TPosition::VECOUT, 1> markQueue;
        pipe.InitBuffer(markQueue, 1, 8 * sizeof(float));
        LocalTensor<float> markLocal = markQueue.AllocTensor<float>();
        markLocal.SetValue(0, 777.0F);
        PipeBarrier<PIPE_ALL>();
        markQueue.EnQue(markLocal);
        markLocal = markQueue.DeQue<float>();
        DataCopyExtParams mParams = {1, sizeof(float), 0, 0, 0};
        DataCopyPad<float>(yGlobal[0], markLocal, mParams);
        PipeBarrier<PIPE_ALL>();
        markQueue.FreeTensor(markLocal);
    }
    TBuf<> rowMaxAllBuf;
    TBuf<> blockMaxBuf;
    TBuf<> reduceTmpBuf;
    TBuf<> sumBuf;
    pipe.InitBuffer(cQueue, 2, kMTask * kNTask * sizeof(float));
    pipe.InitBuffer(rowMaxAllBuf, mTiles * partialStride * sizeof(float));
    pipe.InitBuffer(blockMaxBuf, partialStride * sizeof(float));
    pipe.InitBuffer(reduceTmpBuf, kReduceTmpBytes);
    pipe.InitBuffer(sumBuf, 8 * sizeof(float));

    const uint32_t rowMaxAllElems = mTiles * partialStride;
    uint32_t ping = 0;
    for (uint32_t b = blockIdx; b < batch; b += blockCount) {
        float total = 0.0F;
        LocalTensor<float> rowMaxAll = rowMaxAllBuf.Get<float>(rowMaxAllElems);
        LocalTensor<float> blockMax = blockMaxBuf.Get<float>(partialStride);
        LocalTensor<uint8_t> reduceTmp = reduceTmpBuf.Get<uint8_t>(kReduceTmpBytes);
        LocalTensor<float> sumLocal = sumBuf.Get<float>(8);

        Duplicate(rowMaxAll, kNegInf, rowMaxAllElems);
        PipeBarrier<PIPE_ALL>();

        for (uint32_t mTileId = 0; mTileId < mTiles; ++mTileId) {
            const uint32_t m0 = mTileId * kMTask;
            const uint32_t actualM = MinU32(kMTask, m - m0);
            LocalTensor<float> rowMaxSlice = rowMaxAll[mTileId * partialStride];
            for (uint32_t nShardId = 0; nShardId < nShards; ++nShardId) {
                const uint32_t n0 = nShardId * kNTask;
                const uint32_t actualN = MinU32(kNTask, n - n0);

                CrossCoreWaitFlag<kIntraMode, PIPE_MTE2>(kCFlag);

                GlobalTensor<float> gmTile =
                    cGlobal[static_cast<int64_t>(blockIdx) * 2 * kMTask * kNTask + ping * kMTask * kNTask];
                LocalTensor<float> cLocal = cQueue.AllocTensor<float>();
                DataCopy(cLocal, gmTile, kMTask * kNTask);
                cQueue.EnQue(cLocal);
                cLocal = cQueue.DeQue<float>();

                CrossCoreSetFlag<kIntraMode, PIPE_V>(kVFlag);
                ping = 1 - ping;

                uint32_t reduceShape[2] = {actualM, actualN};
                ReduceMax<float, Pattern::Reduce::AR, true>(blockMax, cLocal, reduceTmp, reduceShape, true);
                if (actualM < partialStride) {
                    for (uint32_t row = actualM; row < partialStride; ++row) {
                        blockMax.SetValue(row, kNegInf);
                    }
                }
                Max(rowMaxSlice, rowMaxSlice, blockMax, partialStride);
                PipeBarrier<PIPE_V>();
                cQueue.FreeTensor<float>(cLocal);
            }
        }

        for (uint32_t mTileId = 0; mTileId < mTiles; ++mTileId) {
            const uint32_t m0 = mTileId * kMTask;
            const uint32_t actualM = MinU32(kMTask, m - m0);
            LocalTensor<float> rowMaxSlice = rowMaxAll[mTileId * partialStride];
            if (actualM < partialStride) {
                for (uint32_t row = actualM; row < partialStride; ++row) {
                    rowMaxSlice.SetValue(row, 0.0F);
                }
                PipeBarrier<PIPE_ALL>();
            }
            uint32_t sumShape[2] = {1, partialStride};
            ReduceSum<float, Pattern::Reduce::AR, true>(sumLocal, rowMaxSlice, reduceTmp, sumShape, true);
            PipeBarrier<PIPE_ALL>();
            total += sumLocal.GetValue(0);
        }

        LocalTensor<float> outputLocal = cQueue.AllocTensor<float>();
        outputLocal.SetValue(0, total);
        PipeBarrier<PIPE_ALL>();
        cQueue.EnQue(outputLocal);
        outputLocal = cQueue.DeQue<float>();
        DataCopyExtParams copyParams = {1, sizeof(float), 0, 0, 0};
        DataCopyPad<float>(yGlobal[b], outputLocal, copyParams);
        PipeBarrier<PIPE_ALL>();
        cQueue.FreeTensor(outputLocal);
    }
}

extern "C" __global__ __aicore__ void batch_matmul_max_sum_fp16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR cWorkspace, uint32_t batch, uint32_t m, uint32_t n, uint32_t k,
    uint32_t mTiles, uint32_t nShards, uint32_t partialStride, uint32_t blockCount, uint8_t transposeX1,
    uint8_t transposeX2) {
    if ASCEND_IS_AIC {
        RunCube<half>(x1, x2, cWorkspace, batch, m, n, k, mTiles, nShards, blockCount, transposeX1 != 0,
                      transposeX2 != 0);
    } else {
        RunVector<half>(y, cWorkspace, batch, m, n, mTiles, nShards, partialStride, blockCount);
    }
}

extern "C" __global__ __aicore__ void batch_matmul_max_sum_bf16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR cWorkspace, uint32_t batch, uint32_t m, uint32_t n, uint32_t k,
    uint32_t mTiles, uint32_t nShards, uint32_t partialStride, uint32_t blockCount, uint8_t transposeX1,
    uint8_t transposeX2) {
    if ASCEND_IS_AIC {
        RunCube<bfloat16_t>(x1, x2, cWorkspace, batch, m, n, k, mTiles, nShards, blockCount, transposeX1 != 0,
                            transposeX2 != 0);
    } else {
        RunVector<bfloat16_t>(y, cWorkspace, batch, m, n, mTiles, nShards, partialStride, blockCount);
    }
}

} // namespace batch_matmul_max_sum_detail

namespace batch_matmul_max_sum_host {

static uint32_t CeilDiv(uint32_t value, uint32_t divisor) {
    return (value + divisor - 1) / divisor;
}

static bool CheckTensorInfo(const TensorGroupInfo &info, int64_t expectedTensorCount, int64_t expectedDims) {
    if (info.tensors == nullptr || info.numTensors < expectedTensorCount || info.tensors[0].shape == nullptr ||
        info.tensors[0].numDims != expectedDims) {
        return false;
    }
    return true;
}

static bool AllocDevice(void **ptr, size_t bytes) {
    if (bytes == 0) {
        return false;
    }
    return aclrtMalloc(ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
}

} // namespace batch_matmul_max_sum_host

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2, const TensorGroupInfo &info_x2,
                           GM_ADDR y, const TensorGroupInfo &info_y, int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2) {
    using namespace batch_matmul_max_sum_host;

    if (x1 == nullptr || x2 == nullptr || y == nullptr || stream == nullptr || availableCoreNum <= 0 ||
        !CheckTensorInfo(info_x1, 1, 3) || !CheckTensorInfo(info_x2, 1, 3) || !CheckTensorInfo(info_y, 1, 1)) {
        return;
    }

    const TensorInfo &x1Info = info_x1.tensors[0];
    const TensorInfo &x2Info = info_x2.tensors[0];
    const TensorInfo &yInfo = info_y.tensors[0];
    if (x1Info.dtype != x2Info.dtype || (x1Info.dtype != 1 && x1Info.dtype != 2) || yInfo.dtype != 0) {
        return;
    }

    const uint32_t batch = static_cast<uint32_t>(x1Info.shape[0]);
    const uint32_t m = static_cast<uint32_t>(transposeX1 ? x1Info.shape[2] : x1Info.shape[1]);
    const uint32_t k = static_cast<uint32_t>(transposeX1 ? x1Info.shape[1] : x1Info.shape[2]);
    const uint32_t batch2 = static_cast<uint32_t>(x2Info.shape[0]);
    const uint32_t k2 = static_cast<uint32_t>(transposeX2 ? x2Info.shape[2] : x2Info.shape[1]);
    const uint32_t n = static_cast<uint32_t>(transposeX2 ? x2Info.shape[1] : x2Info.shape[2]);

    if (batch == 0 || batch > 64 || batch2 != batch || m == 0 || m > 8192 || n == 0 || n > 8192 || k < 32 || k > 8192 ||
        k2 != k || (k % 8) != 0 || yInfo.shape[0] != static_cast<int64_t>(batch) ||
        static_cast<uint64_t>(batch) * m * k > (1ULL << 26) || static_cast<uint64_t>(batch) * n * k > (1ULL << 26)) {
        return;
    }

    uint32_t coreCount = static_cast<uint32_t>(availableCoreNum);
    if (coreCount == 0) {
        coreCount = 1;
    }

    const uint32_t taskM = std::min(m, batch_matmul_max_sum_detail::kMTask);
    const uint32_t mTiles = CeilDiv(m, taskM);
    const uint32_t taskN = std::min(n, batch_matmul_max_sum_detail::kNTask);
    const uint32_t nShards = CeilDiv(n, taskN);
    const uint32_t blockCount = std::min(coreCount, batch);
    const uint32_t partialStride = taskM;

    /* C ping-pong 工作区（每核 2 x 64x128 fp32），grow-only 缓存。 */
    struct CachedBuffers {
        uint8_t *cWorkspace = nullptr;
        size_t cWorkspaceSize = 0;
    };
    static CachedBuffers g_cache;
    static std::mutex g_cacheMutex;
    std::lock_guard<std::mutex> cacheLock(g_cacheMutex);

    const size_t cWorkspaceBytes = static_cast<size_t>(blockCount) * 2 *
                                   batch_matmul_max_sum_detail::kMTask * batch_matmul_max_sum_detail::kNTask *
                                   sizeof(float);
    if (g_cache.cWorkspaceSize < cWorkspaceBytes) {
        uint8_t *t = nullptr;
        if (!AllocDevice(reinterpret_cast<void **>(&t), cWorkspaceBytes)) {
            return;
        }
        if (g_cache.cWorkspace != nullptr) {
            aclrtFree(g_cache.cWorkspace);
        }
        g_cache.cWorkspace = t;
        g_cache.cWorkspaceSize = cWorkspaceBytes;
    }

    if (x1Info.dtype == 1) {
        batch_matmul_max_sum_detail::batch_matmul_max_sum_fp16<<<blockCount, nullptr, stream>>>(
            x1, x2, y, g_cache.cWorkspace, batch, m, n, k, mTiles, nShards, partialStride, blockCount,
            transposeX1 ? 1 : 0, transposeX2 ? 1 : 0);
    } else {
        batch_matmul_max_sum_detail::batch_matmul_max_sum_bf16<<<blockCount, nullptr, stream>>>(
            x1, x2, y, g_cache.cWorkspace, batch, m, n, k, mTiles, nShards, partialStride, blockCount,
            transposeX1 ? 1 : 0, transposeX2 ? 1 : 0);
    }

    (void)aclrtSynchronizeStream(stream);
}
