#include <algorithm>
#include <cfloat>
#include <cstdint>
#include <vector>

#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

/*
 * BatchMatmulMaxSum, direct-invocation version for Ascend 910C / CANN 9.0.
 *
 * This file is #included by main.asc.  It intentionally does not define
 * main(), a pragma once, or an include guard.
 *
 * One kernel owns one batch item and performs all M/N tiles before writing y.
 * It keeps the maximum over N in UB, so the complete B*M*N matrix is never
 * materialized in GM.  A per-block scratch tile receives each C block and is
 * consumed immediately by Vector.  Keeping the complete reduction inside the
 * owning block also avoids a second kernel launch and cross-core atomic
 * reductions.
 */

using namespace AscendC;
using namespace matmul;

namespace batch_matmul_max_sum_detail {

constexpr float kNegInf = -3.402823466e+38F;
constexpr uint32_t kBaseN = 128;
constexpr uint32_t kMTask = 64;
constexpr uint32_t kReduceTmpBytes = 32 * 1024;

__aicore__ inline uint32_t CeilDiv(uint32_t value, uint32_t divisor) {
  return (value + divisor - 1) / divisor;
}

__aicore__ inline uint32_t RoundUp(uint32_t value, uint32_t align) {
  return CeilDiv(value, align) * align;
}

__aicore__ inline uint32_t MinU32(uint32_t lhs, uint32_t rhs) {
  return lhs < rhs ? lhs : rhs;
}

/* Tiling data is passed through GM by the direct-invocation launcher. */
__aicore__ inline void CopyTiling(TCubeTiling *tiling, GM_ADDR tilingGM) {
  uint32_t *dst = reinterpret_cast<uint32_t *>(tiling);
  auto src = reinterpret_cast<__gm__ uint32_t *>(tilingGM);
  for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); ++i) {
    dst[i] = src[i];
  }
}

template <typename InputT>
__aicore__ inline void
RunMatmulMaxSum(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR workspace,
                GM_ADDR cWorkspace, GM_ADDR tilingGM, uint32_t batch,
                uint32_t m, uint32_t n, uint32_t k, uint32_t mTiles,
                uint32_t nShards, uint32_t taskM, uint32_t taskN,
                uint32_t partialStride, uint32_t blockCount, bool transposeX1,
                bool transposeX2) {
  TCubeTiling tiling;
  CopyTiling(&tiling, tilingGM);

  SetSysWorkspace(workspace);
  if (GetSysWorkSpacePtr() == nullptr) {
    return;
  }

  using AType = MatmulType<TPosition::GM, CubeFormat::ND, InputT, true>;
  using BType = MatmulType<TPosition::GM, CubeFormat::ND, InputT, true>;
  using CType = MatmulType<TPosition::GM, CubeFormat::ND, float>;
  using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float>;
  Matmul<AType, BType, CType, BiasType> matmulObj;

  TPipe pipe;
  TQue<TPosition::VECIN, 1> cQueue;
  TQue<TPosition::VECOUT, 1> outputQueue;
  TBuf<> rowMaxBuf0;
  TBuf<> rowMaxBuf1;
  TBuf<> blockMaxBuf;
  TBuf<> reduceTmpBuf;
  TBuf<> sumBuf;

  const uint32_t cElements = tiling.baseM * tiling.baseN;
  pipe.InitBuffer(cQueue, 1, cElements * sizeof(float));
  pipe.InitBuffer(outputQueue, 1, 8 * sizeof(float));
  pipe.InitBuffer(rowMaxBuf0, partialStride * sizeof(float));
  pipe.InitBuffer(rowMaxBuf1, partialStride * sizeof(float));
  pipe.InitBuffer(blockMaxBuf, partialStride * sizeof(float));
  pipe.InitBuffer(reduceTmpBuf, kReduceTmpBytes);
  pipe.InitBuffer(sumBuf, 8 * sizeof(float));

  GlobalTensor<InputT> x1Global;
  GlobalTensor<InputT> x2Global;
  GlobalTensor<float> yGlobal;
  x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ InputT *>(x1),
                           static_cast<int64_t>(batch) * m * k);
  x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ InputT *>(x2),
                           static_cast<int64_t>(batch) * k * n);
  yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);

  GlobalTensor<float> cWorkspaceGlobal;
  cWorkspaceGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(cWorkspace),
                                   static_cast<int64_t>(blockCount) *
                                       cElements);
  const uint32_t blockIdx = GetBlockIdx();
  GlobalTensor<float> cTile =
      cWorkspaceGlobal[static_cast<int64_t>(blockIdx) * cElements];

  REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), matmulObj, &tiling);

  for (uint32_t b = blockIdx; b < batch; b += blockCount) {
    float total = 0.0F;
    for (uint32_t mTileId = 0; mTileId < mTiles; ++mTileId) {
      const uint32_t m0 = mTileId * taskM;
      const uint32_t actualM = MinU32(taskM, m - m0);

      /* The following buffers hold the current M tile's running maximum. */
      LocalTensor<float> rowMax0 = rowMaxBuf0.Get<float>(partialStride);
      LocalTensor<float> rowMax1 = rowMaxBuf1.Get<float>(partialStride);
      LocalTensor<float> blockMax = blockMaxBuf.Get<float>(partialStride);
      LocalTensor<uint8_t> reduceTmp =
          reduceTmpBuf.Get<uint8_t>(kReduceTmpBytes);
      LocalTensor<float> sumLocal = sumBuf.Get<float>(8);

      Duplicate(rowMax0, kNegInf, partialStride);
      PipeBarrier<PIPE_ALL>();

      for (uint32_t nShardId = 0; nShardId < nShards; ++nShardId) {
        const uint32_t n0 = nShardId * taskN;
        if (n0 >= n) {
          continue;
        }
        const uint32_t actualN = MinU32(taskN, n - n0);
        const int64_t aOffset = static_cast<int64_t>(b) * m * k +
                                (transposeX1 ? static_cast<int64_t>(m0)
                                             : static_cast<int64_t>(m0) * k);
        const int64_t bOffset = static_cast<int64_t>(b) * k * n +
                                (transposeX2 ? static_cast<int64_t>(n0) * k
                                             : static_cast<int64_t>(n0));
        GlobalTensor<InputT> aTile = x1Global[aOffset];
        GlobalTensor<InputT> bTile = x2Global[bOffset];

        /* SetOrgShape preserves the full-M/full-N physical stride. */
        matmulObj.SetOrgShape(m, n, k);
        matmulObj.SetTensorA(aTile, transposeX1);
        matmulObj.SetTensorB(bTile, transposeX2);

        matmulObj.SetSingleShape(static_cast<int>(actualM),
                                 static_cast<int>(actualN),
                                 static_cast<int>(k));

        uint32_t nRound = 0;
        while (matmulObj.template Iterate<true>()) {
          matmulObj.template GetTensorC<true>(cTile, 0, true);
          LocalTensor<float> cLocal = cQueue.AllocTensor<float>();
          DataCopy(cLocal, cTile, cElements);
          cQueue.EnQue(cLocal);
          cLocal = cQueue.DeQue<float>();

          /* Invalid N lanes must be -inf, never zero. */
          const uint32_t nBegin =
              nRound * static_cast<uint32_t>(tiling.baseN);
          const uint32_t validN =
              nBegin < actualN
                  ? MinU32(static_cast<uint32_t>(tiling.baseN),
                           actualN - nBegin)
                  : 0;
          if (validN < static_cast<uint32_t>(tiling.baseN)) {
            for (uint32_t row = 0; row < partialStride; ++row) {
              for (uint32_t col = validN;
                   col < static_cast<uint32_t>(tiling.baseN); ++col) {
                cLocal.SetValue(
                    row * static_cast<uint32_t>(tiling.baseN) + col,
                    kNegInf);
              }
            }
            PipeBarrier<PIPE_ALL>();
          }

          uint32_t reduceShape[2] = {
              partialStride, static_cast<uint32_t>(tiling.baseN)};
          ReduceMax<float, Pattern::Reduce::AR, true>(
              blockMax, cLocal, reduceTmp, reduceShape, true);
          PipeBarrier<PIPE_ALL>();

          Max(rowMax1, rowMax0, blockMax, partialStride);
          PipeBarrier<PIPE_ALL>();

          LocalTensor<float> swapTensor = rowMax0;
          rowMax0 = rowMax1;
          rowMax1 = swapTensor;
          cQueue.FreeTensor<float>(cLocal);
          ++nRound;
        }
      }

      /* Zero rows outside the M tail before the M-tile sum is accumulated. */
      if (actualM < partialStride) {
        for (uint32_t row = actualM; row < partialStride; ++row) {
          rowMax0.SetValue(row, 0.0F);
        }
        PipeBarrier<PIPE_ALL>();
      }

      uint32_t sumShape[2] = {1, partialStride};
      ReduceSum<float, Pattern::Reduce::AR, true>(sumLocal, rowMax0, reduceTmp,
                                                  sumShape, true);
      PipeBarrier<PIPE_ALL>();
      total += sumLocal.GetValue(0);
    }

    LocalTensor<float> outputLocal = outputQueue.AllocTensor<float>();
    outputLocal.SetValue(0, total);
    PipeBarrier<PIPE_ALL>();
    outputQueue.EnQue(outputLocal);
    outputLocal = outputQueue.DeQue<float>();
    DataCopyExtParams copyParams = {1, sizeof(float), 0, 0, 0};
    DataCopyPad<float>(yGlobal[b], outputLocal, copyParams);
    PipeBarrier<PIPE_ALL>();
    outputQueue.FreeTensor(outputLocal);
  }

  matmulObj.End();
}

extern "C" __global__ __aicore__ void batch_matmul_max_sum_fp16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR __kfc_workspace__ workspace,
    GM_ADDR cWorkspace, GM_ADDR tilingGM, uint32_t batch, uint32_t m,
    uint32_t n, uint32_t k, uint32_t mTiles, uint32_t nShards, uint32_t taskM,
    uint32_t taskN, uint32_t partialStride, uint32_t blockCount,
    uint8_t transposeX1, uint8_t transposeX2) {
  RunMatmulMaxSum<half>(x1, x2, y, workspace, cWorkspace, tilingGM, batch, m, n,
                        k, mTiles, nShards, taskM, taskN, partialStride,
                        blockCount, transposeX1 != 0, transposeX2 != 0);
}

extern "C" __global__ __aicore__ void batch_matmul_max_sum_bf16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR __kfc_workspace__ workspace,
    GM_ADDR cWorkspace, GM_ADDR tilingGM, uint32_t batch, uint32_t m,
    uint32_t n, uint32_t k, uint32_t mTiles, uint32_t nShards, uint32_t taskM,
    uint32_t taskN, uint32_t partialStride, uint32_t blockCount,
    uint8_t transposeX1, uint8_t transposeX2) {
  RunMatmulMaxSum<bfloat16_t>(x1, x2, y, workspace, cWorkspace, tilingGM,
                              batch, m, n, k, mTiles, nShards, taskM, taskN,
                              partialStride, blockCount, transposeX1 != 0,
                              transposeX2 != 0);
}

} // namespace batch_matmul_max_sum_detail

namespace batch_matmul_max_sum_host {

struct HostTiling {
  std::vector<uint8_t> data;
};

static uint32_t CeilDiv(uint32_t value, uint32_t divisor) {
  return (value + divisor - 1) / divisor;
}

static uint32_t RoundUp(uint32_t value, uint32_t align) {
  return CeilDiv(value, align) * align;
}

static bool BuildMatmulTiling(uint32_t m, uint32_t n, uint32_t k,
                              uint32_t taskM, uint32_t taskN, uint32_t baseM,
                              uint32_t baseN, uint32_t blockCount,
                              int32_t inputDtype, bool transposeX1,
                              bool transposeX2, HostTiling &hostTiling) {
  auto ascendcPlatform =
      platform_ascendc::PlatformAscendCManager::GetInstance();
  if (ascendcPlatform == nullptr) {
    return false;
  }

  matmul_tiling::MultiCoreMatmulTiling tilingApi(*ascendcPlatform);
  const matmul_tiling::DataType inputType =
      inputDtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                      : matmul_tiling::DataType::DT_BFLOAT16;

  if (tilingApi.SetDim(static_cast<int32_t>(blockCount)) < 0 ||
      tilingApi.SetAType(matmul_tiling::TPosition::GM,
                         matmul_tiling::CubeFormat::ND, inputType,
                         transposeX1) < 0 ||
      tilingApi.SetBType(matmul_tiling::TPosition::GM,
                         matmul_tiling::CubeFormat::ND, inputType,
                         transposeX2) < 0 ||
      tilingApi.SetCType(matmul_tiling::TPosition::GM,
                         matmul_tiling::CubeFormat::ND,
                         matmul_tiling::DataType::DT_FLOAT) < 0 ||
      tilingApi.SetBiasType(matmul_tiling::TPosition::GM,
                            matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT) < 0 ||
      tilingApi.SetOrgShape(static_cast<int32_t>(m), static_cast<int32_t>(n),
                            static_cast<int32_t>(k)) < 0 ||
      tilingApi.SetShape(static_cast<int32_t>(taskM),
                         static_cast<int32_t>(taskN),
                         static_cast<int32_t>(k)) < 0 ||
      tilingApi.SetSingleShape(static_cast<int32_t>(taskM),
                               static_cast<int32_t>(taskN),
                               static_cast<int32_t>(k)) < 0 ||
      tilingApi.SetFixSplit(static_cast<int32_t>(baseM),
                            static_cast<int32_t>(baseN), -1) < 0 ||
      tilingApi.EnableBias(false) < 0 ||
      tilingApi.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTN) < 0 ||
      tilingApi.SetBufferSpace(-1, -1, -1) < 0) {
    return false;
  }

  optiling::TCubeTiling tilingData;
  if (tilingApi.GetTiling(tilingData) < 0) {
    return false;
  }

  const uint32_t tilingBytes = tilingData.GetDataSize();
  if (tilingBytes == 0) {
    return false;
  }
  hostTiling.data.resize(tilingBytes);
  tilingData.SaveToBuffer(hostTiling.data.data(), hostTiling.data.size());
  return true;
}

static bool CheckTensorInfo(const TensorGroupInfo &info,
                            int64_t expectedTensorCount, int64_t expectedDims) {
  if (info.tensors == nullptr || info.numTensors < expectedTensorCount ||
      info.tensors[0].shape == nullptr ||
      info.tensors[0].numDims != expectedDims) {
    return false;
  }
  return true;
}

static bool AllocDevice(void **ptr, size_t bytes) {
  if (bytes == 0) {
    return false;
  }
  return aclrtMalloc(ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
}

} // namespace batch_matmul_max_sum_host

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1,
                           GM_ADDR x2, const TensorGroupInfo &info_x2,
                           GM_ADDR y, const TensorGroupInfo &info_y,
                           int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2) {
  using namespace batch_matmul_max_sum_host;

  if (x1 == nullptr || x2 == nullptr || y == nullptr || stream == nullptr ||
      availableCoreNum <= 0 || !CheckTensorInfo(info_x1, 1, 3) ||
      !CheckTensorInfo(info_x2, 1, 3) || !CheckTensorInfo(info_y, 1, 1)) {
    return;
  }

  const TensorInfo &x1Info = info_x1.tensors[0];
  const TensorInfo &x2Info = info_x2.tensors[0];
  const TensorInfo &yInfo = info_y.tensors[0];
  if (x1Info.dtype != x2Info.dtype ||
      (x1Info.dtype != 1 && x1Info.dtype != 2) || yInfo.dtype != 0) {
    return;
  }

  const uint32_t batch = static_cast<uint32_t>(x1Info.shape[0]);
  const uint32_t m =
      static_cast<uint32_t>(transposeX1 ? x1Info.shape[2] : x1Info.shape[1]);
  const uint32_t k =
      static_cast<uint32_t>(transposeX1 ? x1Info.shape[1] : x1Info.shape[2]);
  const uint32_t batch2 = static_cast<uint32_t>(x2Info.shape[0]);
  const uint32_t k2 =
      static_cast<uint32_t>(transposeX2 ? x2Info.shape[2] : x2Info.shape[1]);
  const uint32_t n =
      static_cast<uint32_t>(transposeX2 ? x2Info.shape[1] : x2Info.shape[2]);

  if (batch == 0 || batch > 64 || batch2 != batch || m == 0 || m > 8192 ||
      n == 0 || n > 8192 || k < 32 || k > 8192 || k2 != k || (k % 8) != 0 ||
      yInfo.shape[0] != static_cast<int64_t>(batch) ||
      static_cast<uint64_t>(batch) * m * k > (1ULL << 26) ||
      static_cast<uint64_t>(batch) * n * k > (1ULL << 26)) {
    return;
  }

  uint32_t coreCount = static_cast<uint32_t>(availableCoreNum);
  if (coreCount == 0) {
    coreCount = 1;
  }

  /* Keep the logical per-task shape unpadded; SetFixSplit supplies the
   * hardware-aligned base block, and SetSingleShape handles the tail. */
  const uint32_t taskM = std::min(m, batch_matmul_max_sum_detail::kMTask);
  const uint32_t mTiles = CeilDiv(m, taskM);
  /*
   * Keep each Matmul invocation to one manageable N tile.  The enclosing
   * kernel still consumes every N shard and performs the final reduction, so
   * this does not add another kernel launch.
   */
  const uint32_t taskN = std::min(n, batch_matmul_max_sum_detail::kBaseN);
  const uint32_t nShards = CeilDiv(n, taskN);

  const uint32_t baseM = RoundUp(taskM, 16);
  const uint32_t baseN = RoundUp(taskN, 16);
  const uint32_t blockCount = std::min(coreCount, batch);
  const uint32_t partialStride = baseM;

  HostTiling hostTiling;
  if (!BuildMatmulTiling(m, n, k, taskM, taskN, baseM, baseN, blockCount,
                         x1Info.dtype, transposeX1, transposeX2, hostTiling)) {
    return;
  }

  const size_t tilingBytes = hostTiling.data.size();
  auto ascendcPlatform =
      platform_ascendc::PlatformAscendCManager::GetInstance();
  if (ascendcPlatform == nullptr) {
    return;
  }
  size_t workspaceBytes = ascendcPlatform->GetLibApiWorkSpaceSize();
  if (workspaceBytes == 0) {
    workspaceBytes = 32;
  }

  uint8_t *tilingDevice = nullptr;
  uint8_t *workspaceDevice = nullptr;
  uint8_t *cWorkspaceDevice = nullptr;
  const size_t cWorkspaceBytes = static_cast<size_t>(blockCount) *
                                 static_cast<size_t>(baseM) *
                                 static_cast<size_t>(baseN) * sizeof(float);
  if (!AllocDevice(reinterpret_cast<void **>(&tilingDevice), tilingBytes) ||
      !AllocDevice(reinterpret_cast<void **>(&workspaceDevice),
                   workspaceBytes) ||
      !AllocDevice(reinterpret_cast<void **>(&cWorkspaceDevice),
                   cWorkspaceBytes)) {
    if (cWorkspaceDevice != nullptr) {
      aclrtFree(cWorkspaceDevice);
    }
    if (workspaceDevice != nullptr) {
      aclrtFree(workspaceDevice);
    }
    if (tilingDevice != nullptr) {
      aclrtFree(tilingDevice);
    }
    return;
  }

  if (aclrtMemcpy(tilingDevice, tilingBytes, hostTiling.data.data(),
                  tilingBytes, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
    aclrtFree(cWorkspaceDevice);
    aclrtFree(workspaceDevice);
    aclrtFree(tilingDevice);
    return;
  }

  if (x1Info.dtype == 1) {
    batch_matmul_max_sum_detail::
        batch_matmul_max_sum_fp16<<<blockCount, nullptr, stream>>>(
            x1, x2, y, workspaceDevice, cWorkspaceDevice, tilingDevice, batch,
            m, n, k, mTiles, nShards, taskM, taskN, partialStride, blockCount,
            transposeX1 ? 1 : 0, transposeX2 ? 1 : 0);
  } else {
    batch_matmul_max_sum_detail::
        batch_matmul_max_sum_bf16<<<blockCount, nullptr, stream>>>(
            x1, x2, y, workspaceDevice, cWorkspaceDevice, tilingDevice, batch,
            m, n, k, mTiles, nShards, taskM, taskN, partialStride, blockCount,
            transposeX1 ? 1 : 0, transposeX2 ? 1 : 0);
  }

  /*
   * aclrtFree is intentionally delayed until the stream has completed: the
   * kernel still uses the tiling and system-workspace buffers after launch
   * returns.  This synchronization is also compatible with the direct-
   * invocation main, which performs a second harmless stream synchronization
   * before the output copy.
   */
  (void)aclrtSynchronizeStream(stream);
  aclrtFree(cWorkspaceDevice);
  aclrtFree(workspaceDevice);
  aclrtFree(tilingDevice);
}
