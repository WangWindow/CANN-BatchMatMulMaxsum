#include <algorithm>
#include <cfloat>
#include <cstdint>
#include <mutex>
#include <vector>

#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

/*
 * BatchMatmulMaxSum，适用于 Ascend 910C / CANN 9.0 的直调版本。
 *
 * 本文件由 main.asc 使用 #include 引入，不定义 main()、pragma once 或头文件保护宏。
 *
 * 一个核负责一个 batch，在写回 y 前完成所有 M/N 分块。
 * 沿 N 维的行最大值保存在 UB 中，不将完整的 B*M*N 矩阵写入 GM。
 * 每核使用独立的 GM 临时块接收 MatMul 结果，再立即由 Vector 处理。
 * 全部归约在负责该 batch 的核内完成，避免第二次核启动和跨核原子归约。
 */

using namespace AscendC;
using namespace matmul;

namespace batch_matmul_max_sum_detail {

constexpr float kNegInf = -3.402823466e+38F;
constexpr uint32_t kBaseN = 128;
constexpr uint32_t kMTask = 64;
constexpr uint32_t kReduceTmpBytes = 32 * 1024;

__aicore__ inline uint32_t CeilDiv(uint32_t value, uint32_t divisor) {
    return (value + divisor - 1) / divisor;
}

__aicore__ inline uint32_t RoundUp(uint32_t value, uint32_t align) {
    return CeilDiv(value, align) * align;
}

__aicore__ inline uint32_t MinU32(uint32_t lhs, uint32_t rhs) {
    return lhs < rhs ? lhs : rhs;
}

/* 直调启动函数通过 GM 传递 Tiling 数据。 */
__aicore__ inline void CopyTiling(TCubeTiling *tiling, GM_ADDR tilingGM) {
    uint32_t *dst = reinterpret_cast<uint32_t *>(tiling);
    auto src = reinterpret_cast<__gm__ uint32_t *>(tilingGM);
    for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); ++i) {
        dst[i] = src[i];
    }
}

template <typename InputT>
__aicore__ inline void RunMatmulMaxSum(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR workspace, GM_ADDR cWorkspace,
                                       GM_ADDR tilingGM, uint32_t batch, uint32_t m, uint32_t n, uint32_t k,
                                       uint32_t mTiles, uint32_t nShards, uint32_t taskM, uint32_t taskN,
                                       uint32_t partialStride, uint32_t blockCount, bool transposeX1,
                                       bool transposeX2) {
    TCubeTiling tiling;
    CopyTiling(&tiling, tilingGM);

    SetSysWorkspace(workspace);
    if (GetSysWorkSpacePtr() == nullptr) {
        return;
    }

    using AType = MatmulType<TPosition::GM, CubeFormat::ND, InputT, true>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, InputT, true>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float>;
    Matmul<AType, BType, CType, BiasType> matmulObj;

    TPipe pipe;
    TQue<TPosition::VECIN, 1> cQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<> rowMaxAllBuf;
    TBuf<> blockMaxBuf;
    TBuf<> reduceTmpBuf;
    TBuf<> sumBuf;

    const uint32_t cElements = tiling.baseM * tiling.baseN;
    const uint32_t rowMaxAllElems = mTiles * partialStride;
    pipe.InitBuffer(cQueue, 1, cElements * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, 8 * sizeof(float));
    pipe.InitBuffer(rowMaxAllBuf, rowMaxAllElems * sizeof(float));
    pipe.InitBuffer(blockMaxBuf, partialStride * sizeof(float));
    pipe.InitBuffer(reduceTmpBuf, kReduceTmpBytes);
    pipe.InitBuffer(sumBuf, 8 * sizeof(float));

    GlobalTensor<InputT> x1Global;
    GlobalTensor<InputT> x2Global;
    GlobalTensor<float> yGlobal;
    x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ InputT *>(x1), static_cast<int64_t>(batch) * m * k);
    x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ InputT *>(x2), static_cast<int64_t>(batch) * k * n);
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);

    GlobalTensor<float> cWorkspaceGlobal;
    cWorkspaceGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(cWorkspace),
                                     static_cast<int64_t>(blockCount) * m * n);
    const uint32_t blockIdx = GetBlockIdx();

    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), matmulObj, &tiling);

    for (uint32_t b = blockIdx; b < batch; b += blockCount) {
        float total = 0.0F;

        /*
         * Stage 2：每个 (core, batch) 只提交一个 MatMul 作业（SetSingleShape(m, n, k)），
         * tiling 采用 FIRSTM 遍历（M 方向内层），B 块在内层 M 循环中留 L1 复用，
         * 不再随每个 mTile 重读。行最大值累加器按 mTile 常驻 UB（rowMaxAll）。
         */
        LocalTensor<float> rowMaxAll = rowMaxAllBuf.Get<float>(rowMaxAllElems);
        LocalTensor<float> blockMax = blockMaxBuf.Get<float>(partialStride);
        LocalTensor<uint8_t> reduceTmp = reduceTmpBuf.Get<uint8_t>(kReduceTmpBytes);
        LocalTensor<float> sumLocal = sumBuf.Get<float>(8);

        Duplicate(rowMaxAll, kNegInf, rowMaxAllElems);
        PipeBarrier<PIPE_ALL>();

        const int64_t aOffset = static_cast<int64_t>(b) * m * k;
        const int64_t bOffset = static_cast<int64_t>(b) * k * n;
        matmulObj.SetOrgShape(m, n, k);
        matmulObj.SetTensorA(x1Global[aOffset], transposeX1);
        matmulObj.SetTensorB(x2Global[bOffset], transposeX2);
        matmulObj.SetSingleShape(static_cast<int>(m), static_cast<int>(n), static_cast<int>(k));

        /*
         * IterateAll：一条消息让服务端计算全部 tile 并写入完整的 M×N C 矩阵
         * （每个 tile 落到自身的 (m0, n0) 位置），客户端随后按已知位置归约，
         * 完全不依赖服务端 tile 遍历顺序。
         */
        GlobalTensor<float> cFull =
            cWorkspaceGlobal[static_cast<int64_t>(blockIdx) * m * n];
        matmulObj.template IterateAll<true>(cFull, 0, false, false, false);

        for (uint32_t mTileId = 0; mTileId < mTiles; ++mTileId) {
            const uint32_t m0 = mTileId * taskM;
            const uint32_t actualM = MinU32(taskM, m - m0);
            LocalTensor<float> rowMaxSlice = rowMaxAll[mTileId * partialStride];
            for (uint32_t nShardId = 0; nShardId < nShards; ++nShardId) {
                const uint32_t n0 = nShardId * static_cast<uint32_t>(tiling.baseN);
                const uint32_t validN = MinU32(static_cast<uint32_t>(tiling.baseN), n - n0);

                GlobalTensor<float> cTile = cFull[static_cast<int64_t>(m0) * n + n0];
                LocalTensor<float> cLocal = cQueue.AllocTensor<float>();
                const bool isTail = actualM < partialStride || validN < static_cast<uint32_t>(tiling.baseN);
                const uint32_t paddedN = RoundUp(validN, 8);
                if (isTail) {
                    /* 行宽补齐到 32 字节，负无穷填充，源行宽为完整矩阵行宽 n。 */
                    DataCopyExtParams copyParams = {static_cast<uint16_t>(actualM),
                                                    validN * static_cast<uint32_t>(sizeof(float)),
                                                    static_cast<uint16_t>((n - validN) * sizeof(float)), 0, 0};
                    DataCopyPadExtParams<float> padParams = {true, 0, static_cast<uint8_t>(paddedN - validN),
                                                             kNegInf};
                    DataCopyPad(cLocal, cTile, copyParams, padParams);
                } else {
                    DataCopyExtParams copyParams = {static_cast<uint16_t>(actualM),
                                                    validN * static_cast<uint32_t>(sizeof(float)),
                                                    static_cast<uint16_t>((n - validN) * sizeof(float)), 0, 0};
                    DataCopyPadExtParams<float> padParams = {false, 0, 0, 0.0F};
                    DataCopyPad(cLocal, cTile, copyParams, padParams);
                }
                cQueue.EnQue(cLocal);
                cLocal = cQueue.DeQue<float>();

                uint32_t reduceShape[2] = {actualM, paddedN};
                ReduceMax<float, Pattern::Reduce::AR, true>(blockMax, cLocal, reduceTmp, reduceShape, true);
                if (actualM < partialStride) {
                    PipeBarrier<PIPE_ALL>();
                    for (uint32_t row = actualM; row < partialStride; ++row) {
                        blockMax.SetValue(row, kNegInf);
                    }
                }
                PipeBarrier<PIPE_ALL>();

                Max(rowMaxSlice, rowMaxSlice, blockMax, partialStride);
                PipeBarrier<PIPE_ALL>();

                cQueue.FreeTensor<float>(cLocal);
            }
        }

        /* 每个 M 分块各自归约求和：先清零无效行，再 ReduceSum。 */
        for (uint32_t mTileId = 0; mTileId < mTiles; ++mTileId) {
            const uint32_t m0 = mTileId * taskM;
            const uint32_t actualM = MinU32(taskM, m - m0);
            LocalTensor<float> rowMaxSlice = rowMaxAll[mTileId * partialStride];
            if (actualM < partialStride) {
                for (uint32_t row = actualM; row < partialStride; ++row) {
                    rowMaxSlice.SetValue(row, 0.0F);
                }
                PipeBarrier<PIPE_ALL>();
            }
            uint32_t sumShape[2] = {1, partialStride};
            ReduceSum<float, Pattern::Reduce::AR, true>(sumLocal, rowMaxSlice, reduceTmp, sumShape, true);
            PipeBarrier<PIPE_ALL>();
            total += sumLocal.GetValue(0);
        }

        LocalTensor<float> outputLocal = outputQueue.AllocTensor<float>();
        outputLocal.SetValue(0, total);
        PipeBarrier<PIPE_ALL>();
        outputQueue.EnQue(outputLocal);
        outputLocal = outputQueue.DeQue<float>();
        DataCopyExtParams copyParams = {1, sizeof(float), 0, 0, 0};
        DataCopyPad<float>(yGlobal[b], outputLocal, copyParams);
        PipeBarrier<PIPE_ALL>();
        outputQueue.FreeTensor(outputLocal);
    }

    matmulObj.End();
}

extern "C" __global__ __aicore__ void batch_matmul_max_sum_fp16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR __kfc_workspace__ workspace, GM_ADDR cWorkspace, GM_ADDR tilingGM,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, uint32_t mTiles, uint32_t nShards, uint32_t taskM,
    uint32_t taskN, uint32_t partialStride, uint32_t blockCount, uint8_t transposeX1, uint8_t transposeX2) {
    RunMatmulMaxSum<half>(x1, x2, y, workspace, cWorkspace, tilingGM, batch, m, n, k, mTiles, nShards, taskM, taskN,
                          partialStride, blockCount, transposeX1 != 0, transposeX2 != 0);
}

extern "C" __global__ __aicore__ void batch_matmul_max_sum_bf16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR __kfc_workspace__ workspace, GM_ADDR cWorkspace, GM_ADDR tilingGM,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, uint32_t mTiles, uint32_t nShards, uint32_t taskM,
    uint32_t taskN, uint32_t partialStride, uint32_t blockCount, uint8_t transposeX1, uint8_t transposeX2) {
    RunMatmulMaxSum<bfloat16_t>(x1, x2, y, workspace, cWorkspace, tilingGM, batch, m, n, k, mTiles, nShards, taskM,
                                taskN, partialStride, blockCount, transposeX1 != 0, transposeX2 != 0);
}

/* 本地调试入口：与 fp16 主入口相同，供调试流程转储 C workspace 用。 */
extern "C" __global__ __aicore__ void batch_matmul_max_sum_fp16_debug(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR __kfc_workspace__ workspace, GM_ADDR cWorkspace, GM_ADDR tilingGM,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, uint32_t mTiles, uint32_t nShards, uint32_t taskM,
    uint32_t taskN, uint32_t partialStride, uint32_t blockCount, uint8_t transposeX1, uint8_t transposeX2,
    GM_ADDR debugDump) {
    (void)debugDump;
    RunMatmulMaxSum<half>(x1, x2, y, workspace, cWorkspace, tilingGM, batch, m, n, k, mTiles, nShards, taskM, taskN,
                          partialStride, blockCount, transposeX1 != 0, transposeX2 != 0);
}

} // namespace batch_matmul_max_sum_detail

namespace batch_matmul_max_sum_host {

struct HostTiling {
    std::vector<uint8_t> data;
};

static uint32_t CeilDiv(uint32_t value, uint32_t divisor) {
    return (value + divisor - 1) / divisor;
}

static uint32_t RoundUp(uint32_t value, uint32_t align) {
    return CeilDiv(value, align) * align;
}

static bool BuildMatmulTiling(uint32_t m, uint32_t n, uint32_t k, uint32_t taskM, uint32_t taskN, uint32_t baseM,
                              uint32_t baseN, uint32_t blockCount, int32_t inputDtype, bool transposeX1,
                              bool transposeX2, HostTiling &hostTiling) {
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (ascendcPlatform == nullptr) {
        return false;
    }

    matmul_tiling::MultiCoreMatmulTiling tilingApi(*ascendcPlatform);
    const matmul_tiling::DataType inputType =
        inputDtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 : matmul_tiling::DataType::DT_BFLOAT16;

    if (tilingApi.SetDim(1) < 0 ||
        tilingApi.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, transposeX1) < 0 ||
        tilingApi.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, transposeX2) < 0 ||
        tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_FLOAT) < 0 ||
        tilingApi.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                              matmul_tiling::DataType::DT_FLOAT) < 0 ||
        tilingApi.SetOrgShape(static_cast<int32_t>(m), static_cast<int32_t>(n), static_cast<int32_t>(k)) < 0 ||
        tilingApi.SetShape(static_cast<int32_t>(m), static_cast<int32_t>(n), static_cast<int32_t>(k)) < 0 ||
        tilingApi.SetSingleShape(static_cast<int32_t>(m), static_cast<int32_t>(n), static_cast<int32_t>(k)) < 0 ||
        tilingApi.SetFixSplit(static_cast<int32_t>(baseM), static_cast<int32_t>(baseN), -1) < 0 ||
        tilingApi.EnableBias(false) < 0 || tilingApi.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM) < 0 ||
        tilingApi.SetBufferSpace(-1, -1, -1) < 0) {
        return false;
    }

    optiling::TCubeTiling tilingData;
    if (tilingApi.GetTiling(tilingData) < 0) {
        return false;
    }

    const uint32_t tilingBytes = tilingData.GetDataSize();
    if (tilingBytes == 0) {
        return false;
    }
    hostTiling.data.resize(tilingBytes);
    tilingData.SaveToBuffer(hostTiling.data.data(), hostTiling.data.size());
    return true;
}

static bool CheckTensorInfo(const TensorGroupInfo &info, int64_t expectedTensorCount, int64_t expectedDims) {
    if (info.tensors == nullptr || info.numTensors < expectedTensorCount || info.tensors[0].shape == nullptr ||
        info.tensors[0].numDims != expectedDims) {
        return false;
    }
    return true;
}

static bool AllocDevice(void **ptr, size_t bytes) {
    if (bytes == 0) {
        return false;
    }
    return aclrtMalloc(ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
}

} // namespace batch_matmul_max_sum_host

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2, const TensorGroupInfo &info_x2,
                           GM_ADDR y, const TensorGroupInfo &info_y, int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2) {
    using namespace batch_matmul_max_sum_host;

    if (x1 == nullptr || x2 == nullptr || y == nullptr || stream == nullptr || availableCoreNum <= 0 ||
        !CheckTensorInfo(info_x1, 1, 3) || !CheckTensorInfo(info_x2, 1, 3) || !CheckTensorInfo(info_y, 1, 1)) {
        return;
    }

    const TensorInfo &x1Info = info_x1.tensors[0];
    const TensorInfo &x2Info = info_x2.tensors[0];
    const TensorInfo &yInfo = info_y.tensors[0];
    if (x1Info.dtype != x2Info.dtype || (x1Info.dtype != 1 && x1Info.dtype != 2) || yInfo.dtype != 0) {
        return;
    }

    const uint32_t batch = static_cast<uint32_t>(x1Info.shape[0]);
    const uint32_t m = static_cast<uint32_t>(transposeX1 ? x1Info.shape[2] : x1Info.shape[1]);
    const uint32_t k = static_cast<uint32_t>(transposeX1 ? x1Info.shape[1] : x1Info.shape[2]);
    const uint32_t batch2 = static_cast<uint32_t>(x2Info.shape[0]);
    const uint32_t k2 = static_cast<uint32_t>(transposeX2 ? x2Info.shape[2] : x2Info.shape[1]);
    const uint32_t n = static_cast<uint32_t>(transposeX2 ? x2Info.shape[1] : x2Info.shape[2]);

    if (batch == 0 || batch > 64 || batch2 != batch || m == 0 || m > 8192 || n == 0 || n > 8192 || k < 32 || k > 8192 ||
        k2 != k || (k % 8) != 0 || yInfo.shape[0] != static_cast<int64_t>(batch) ||
        static_cast<uint64_t>(batch) * m * k > (1ULL << 26) || static_cast<uint64_t>(batch) * n * k > (1ULL << 26)) {
        return;
    }

    uint32_t coreCount = static_cast<uint32_t>(availableCoreNum);
    if (coreCount == 0) {
        coreCount = 1;
    }

    /* 任务逻辑形状不补齐；SetFixSplit 提供硬件对齐的基本块，SetSingleShape 处理尾块。 */
    const uint32_t taskM = std::min(m, batch_matmul_max_sum_detail::kMTask);
    const uint32_t mTiles = CeilDiv(m, taskM);
    /* 每次 MatMul 只处理一个 N 分块；外层核遍历所有分片并完成最终归约。 */
    const uint32_t taskN = std::min(n, batch_matmul_max_sum_detail::kBaseN);
    const uint32_t nShards = CeilDiv(n, taskN);

    const uint32_t baseM = RoundUp(taskM, 16);
    const uint32_t baseN = RoundUp(taskN, 16);
    const uint32_t blockCount = std::min(coreCount, batch);
    const uint32_t partialStride = baseM;

    HostTiling hostTiling;
    if (!BuildMatmulTiling(m, n, k, taskM, taskN, baseM, baseN, blockCount, x1Info.dtype, transposeX1, transposeX2,
                           hostTiling)) {
        return;
    }

    const size_t tilingBytes = hostTiling.data.size();
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (ascendcPlatform == nullptr) {
        return;
    }
    size_t workspaceBytes = ascendcPlatform->GetLibApiWorkSpaceSize();
    if (workspaceBytes == 0) {
        workspaceBytes = 32;
    }

    /*
     * tiling / 系统 workspace / C workspace 采用进程级 grow-only 静态缓存：
     * KFC 服务端在 AIV 核返回后仍可能短暂读写这些缓冲区，逐调用 malloc/free
     * 会与下一 kernel 的 workspace 清理竞争（实测表现为后续 launch 读到脏数据）。
     * 因此缓冲只增不删；扩容替换旧缓冲时，上一次调用已通过 stream 同步保证安全。
     * 仅缓存 workspace，绝不缓存计算结果（反作弊红线 A5）。
     */
    struct CachedBuffers {
        uint8_t *tiling = nullptr;
        size_t tilingSize = 0;
        uint8_t *workspace = nullptr;
        size_t workspaceSize = 0;
        uint8_t *cWorkspace = nullptr;
        size_t cWorkspaceSize = 0;
    };
    static CachedBuffers g_cache;
    static std::mutex g_cacheMutex;
    std::lock_guard<std::mutex> cacheLock(g_cacheMutex);

    const size_t cWorkspaceBytes =
        static_cast<size_t>(blockCount) * static_cast<size_t>(m) * static_cast<size_t>(n) * sizeof(float);
    if (g_cache.tilingSize < tilingBytes) {
        uint8_t *t = nullptr;
        if (!AllocDevice(reinterpret_cast<void **>(&t), tilingBytes)) {
            return;
        }
        if (g_cache.tiling != nullptr) {
            aclrtFree(g_cache.tiling);
        }
        g_cache.tiling = t;
        g_cache.tilingSize = tilingBytes;
    }
    if (g_cache.workspaceSize < workspaceBytes) {
        uint8_t *t = nullptr;
        if (!AllocDevice(reinterpret_cast<void **>(&t), workspaceBytes)) {
            return;
        }
        if (g_cache.workspace != nullptr) {
            aclrtFree(g_cache.workspace);
        }
        g_cache.workspace = t;
        g_cache.workspaceSize = workspaceBytes;
    }
    if (g_cache.cWorkspaceSize < cWorkspaceBytes) {
        uint8_t *t = nullptr;
        if (!AllocDevice(reinterpret_cast<void **>(&t), cWorkspaceBytes)) {
            return;
        }
        if (g_cache.cWorkspace != nullptr) {
            aclrtFree(g_cache.cWorkspace);
        }
        g_cache.cWorkspace = t;
        g_cache.cWorkspaceSize = cWorkspaceBytes;
    }

    uint8_t *tilingDevice = g_cache.tiling;
    uint8_t *workspaceDevice = g_cache.workspace;
    uint8_t *cWorkspaceDevice = g_cache.cWorkspace;
    if (aclrtMemcpy(tilingDevice, tilingBytes, hostTiling.data.data(), tilingBytes, ACL_MEMCPY_HOST_TO_DEVICE) !=
        ACL_SUCCESS) {
        return;
    }

    if (x1Info.dtype == 1) {
        batch_matmul_max_sum_detail::batch_matmul_max_sum_fp16<<<blockCount, nullptr, stream>>>(
            x1, x2, y, workspaceDevice, cWorkspaceDevice, tilingDevice, batch, m, n, k, mTiles, nShards, taskM, taskN,
            partialStride, blockCount, transposeX1 ? 1 : 0, transposeX2 ? 1 : 0);
    } else {
        batch_matmul_max_sum_detail::batch_matmul_max_sum_bf16<<<blockCount, nullptr, stream>>>(
            x1, x2, y, workspaceDevice, cWorkspaceDevice, tilingDevice, batch, m, n, k, mTiles, nShards, taskM, taskN,
            partialStride, blockCount, transposeX1 ? 1 : 0, transposeX2 ? 1 : 0);
    }

    /*
     * 必须等待流执行完成：KFC 服务端与 workspace 清理由本同步点串行化，
     * 否则连续 launch 会互相污染（实测移除后出现脏结果）。
     */
    (void)aclrtSynchronizeStream(stream);
}
